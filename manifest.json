{
  "manifest_version": 3,
  "name": "LeetCoach",
  "version": "1.0",
  "description": "A Chrome extension that gives hints for LeetCode problems.",

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ]
}